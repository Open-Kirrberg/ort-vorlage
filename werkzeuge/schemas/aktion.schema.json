{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-kirrberg.github.io/ort-vorlage/schemas/aktion.schema.json",
  "title": "Aktion (aktionen/*.yml)",
  "description": "Eine Pflanz-, Entsiegelungs- oder Pflegeaktion. Partner sind Organisationen, keine Privatpersonen (R7).",
  "type": "object",
  "required": ["titel", "art", "datum", "autor", "lizenz"],
  "additionalProperties": false,
  "properties": {
    "titel": { "type": "string", "minLength": 3, "maxLength": 120 },
    "art": { "enum": ["pflanzung", "entsiegelung", "pflege", "sonstiges"] },
    "datum": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "beschreibung": { "type": "string", "maxLength": 2000 },
    "baeume": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "flaeche_m2": { "type": "number", "minimum": 0, "maximum": 10000000 },
    "lage": {
      "type": "object",
      "required": ["lon", "lat"],
      "additionalProperties": false,
      "properties": {
        "lon": { "type": "number", "minimum": 6.3, "maximum": 7.8 },
        "lat": { "type": "number", "minimum": 48.9, "maximum": 49.8 }
      }
    },
    "partner": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 2, "maxLength": 120 } },
    "quelle": { "type": "string", "maxLength": 300 },
    "autor": { "type": "string", "minLength": 2, "maxLength": 60 },
    "lizenz": { "enum": ["CC0-1.0", "CC-BY-4.0", "CC-BY-SA-4.0"] }
  }
}
