{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-kirrberg.github.io/ort-vorlage/schemas/geschichte.schema.json",
  "title": "Geschichte – Front Matter (inhalte/geschichten/*.md)",
  "description": "Kopf einer Geschichte zwischen zwei Zeilen '---'. Texte sind CC BY 4.0 oder CC BY-SA 4.0 (ADR 0054).",
  "type": "object",
  "required": ["titel", "autor", "lizenz", "datum"],
  "additionalProperties": false,
  "properties": {
    "titel": { "type": "string", "minLength": 3, "maxLength": 120 },
    "autor": { "type": "string", "minLength": 2, "maxLength": 60 },
    "lizenz": { "enum": ["CC-BY-4.0", "CC-BY-SA-4.0"] },
    "datum": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "ort": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,59}$" },
    "quellen": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 3, "maxLength": 300 } },
    "bilder": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "pattern": "^bilder/[a-z0-9][a-z0-9_-]{0,79}\\.(jpg|jpeg|png|webp)$" }
    }
  }
}
