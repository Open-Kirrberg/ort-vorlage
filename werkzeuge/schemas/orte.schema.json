{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-kirrberg.github.io/ort-vorlage/schemas/orte.schema.json",
  "title": "Orte (inhalte/orte/*.geojson)",
  "description": "Interessante Punkte eines Ortes: GeoJSON FeatureCollection, WGS84 (Längengrad, Breitengrad). Datenbeiträge sind CC0 1.0, aus OpenStreetMap abgeleitete Punkte ODbL 1.0 (ADR 0054).",
  "type": "object",
  "required": ["type", "features"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["type", "geometry", "properties"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "Feature" },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "Point" },
              "coordinates": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  { "type": "number", "minimum": 6.3, "maximum": 7.8 },
                  { "type": "number", "minimum": 48.9, "maximum": 49.8 }
                ]
              }
            }
          },
          "properties": {
            "type": "object",
            "required": ["id", "name", "kategorie", "autor", "lizenz", "datum"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,59}$" },
              "name": { "type": "string", "minLength": 2, "maxLength": 80 },
              "kategorie": {
                "enum": ["aussicht", "natur", "baum", "wasser", "denkmal", "geschichte", "weg", "spielplatz", "fund", "sonstiges"]
              },
              "beschreibung": { "type": "string", "maxLength": 1000 },
              "quelle": { "type": "string", "maxLength": 300 },
              "autor": { "type": "string", "minLength": 2, "maxLength": 60 },
              "lizenz": { "enum": ["CC0-1.0", "ODbL-1.0"] },
              "datum": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "bild": { "type": "string", "pattern": "^bilder/[a-z0-9][a-z0-9_-]{0,79}\\.(jpg|jpeg|png|webp)$" },
              "hoehe_m": { "type": "number", "minimum": 0, "maximum": 80 }
            }
          }
        }
      }
    }
  }
}
