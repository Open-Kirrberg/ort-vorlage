{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-kirrberg.github.io/ort-vorlage/schemas/bild.schema.json",
  "title": "Bildangaben (inhalte/bilder/<datei>.yml neben jedem Bild)",
  "description": "Nur eigene Fotos, CC BY 4.0 oder CC BY-SA 4.0 (ADR 0054). Keine Personen, Kennzeichen, Briefkästen, privaten Türen oder Höfe (R7).",
  "type": "object",
  "required": ["titel", "autor", "lizenz", "eigenes_foto"],
  "additionalProperties": false,
  "properties": {
    "titel": { "type": "string", "minLength": 3, "maxLength": 120 },
    "autor": { "type": "string", "minLength": 2, "maxLength": 60 },
    "lizenz": { "enum": ["CC-BY-4.0", "CC-BY-SA-4.0"] },
    "eigenes_foto": { "const": true },
    "datum": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
